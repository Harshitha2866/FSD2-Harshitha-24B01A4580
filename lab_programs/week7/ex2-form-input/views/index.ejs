<!DOCTYPE html>
<html>

<head>

    <!-- Page title -->
    <title>Feedback Form</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;

            display: flex;
            justify-content: center;
            align-items: center;

            min-height: 100vh;
            margin: 0;
        }

        .container {
            width: 450px;
            padding: 40px;

            background-color: white;
            border-radius: 12px;

            text-align: center;
        }

        h1 {
            font-size: 32px;
        }

        label {
            display: block;
            font-size: 20px;
            margin-top: 20px;
        }

        input,
        textarea {
            width: 90%;
            box-sizing: border-box;

            padding: 12px;
            margin-top: 8px;

            font-size: 18px;
        }

        textarea {
            height: 100px;
        }

        button {
            margin-top: 25px;
            padding: 12px 30px;

            font-size: 18px;
        }

        .error {
            color: red;
            font-weight: bold;
        }

        .success {
            color: green;
            font-weight: bold;
        }

    </style>

</head>

<body>

    <div class="container">

        <!-- Main heading -->
        <h1>Feedback Form</h1>


        <!-- Display error -->
        <% if (error) { %>

            <p class="error">
                <%= error %>
            </p>

        <% } %>


        <!-- Display success message -->
        <% if (message) { %>

            <p class="success">
                <%= message %>
            </p>

        <% } %>


        <!-- Feedback form -->
        <form action="/submit" method="POST">

            <!-- Name -->
            <label>Name:</label>

            <input
                type="text"
                name="name"
            >


            <!-- Feedback -->
            <label>Feedback:</label>

            <textarea
                name="feedback"
            ></textarea>


            <!-- Submit button -->
            <button type="submit">
                Submit
            </button>

        </form>

    </div>

</body>

</html>